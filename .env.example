# Lead form destination (CRM-agnostic). Set to a Formspree URL or your CRM webhook.
LEAD_ENDPOINT=
# Fallback notification email shown/used server-side (optional).
LEAD_NOTIFY_EMAIL=
# Public analytics IDs (leave blank to disable). Client-visible by design.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Toggle clearly-labelled demo testimonials/stats. "true" shows them, "false" hides all.
NEXT_PUBLIC_DEMO_CONTENT=true
# Canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://unihunt.in
